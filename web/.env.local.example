# Copy to `.env.local` and paste your SmartScout session token.
# Server-side only — never exposed to the browser.
# Capture it from a logged-in SmartScout tab: DevTools -> Network -> a `*/search`
# request -> the value after "Authorization: Bearer ". It expires; re-capture on 401.
SMARTSCOUT_TOKEN=

# Optional: default marketplace when a request does not specify one.
SMARTSCOUT_MARKETPLACE=US

# Optional: min ms between SmartScout requests (politeness / lower ban risk).
SMARTSCOUT_MIN_INTERVAL_MS=1200

# --- Google Sheets auto-fill (Subcategory -> "Start — fill sheet") ---
# Create a Google Cloud service account, enable the Google Sheets API, download
# its JSON key, and SHARE the target sheet with the service-account email (Editor).
# Paste the whole key JSON on one line (keep the \n inside private_key as-is).
GOOGLE_SERVICE_ACCOUNT_JSON=
# The spreadsheet id (from its URL: /spreadsheets/d/<THIS>/edit).
GOOGLE_SHEET_ID=
