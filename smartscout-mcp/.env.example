# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# Your SmartScout web session token — the value after "Bearer " in the
# Authorization header of a captured request (see README -> "Getting your token").
# It expires periodically; re-capture when calls start returning 401.
SMARTSCOUT_TOKEN=

# SmartScout API backend (confirmed from a real capture).
SMARTSCOUT_BASE_URL=https://smartscoutapi-east.azurewebsites.net

# Default Amazon marketplace when a tool call does not specify one.
# Sent automatically as the X-SmartScout-Marketplace header.
# Supported: US, UK, DE, CA, MX, FR, IT, ES
SMARTSCOUT_MARKETPLACE=US

# Minimum milliseconds between requests (politeness / lower ban risk).
SMARTSCOUT_MIN_INTERVAL_MS=1200

# --- Advanced (defaults match the real web app; usually leave unset) ---
# SMARTSCOUT_AUTH_HEADER=Authorization
# SMARTSCOUT_AUTH_PREFIX="Bearer "
# SMARTSCOUT_CONTENT_TYPE=application/json-patch+json
# SMARTSCOUT_ORIGIN=https://app.smartscout.com
# SMARTSCOUT_REFERER=https://app.smartscout.com/
# SMARTSCOUT_EXTRA_HEADERS={"X-Foo":"bar"}
